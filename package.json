{
  "name": "phantom-blade-zero-guide",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "《影之刃零》非官方中文攻略资料站 — 影境手册 / PBZ Codex",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.ssr.json --noEmit && tsc -p e2e/tsconfig.json --noEmit",
    "typecheck:files": "node scripts/list-ts-files.mjs",
    "lint": "eslint .",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "content": "node scripts/build-content.mjs",
    "layout": "node scripts/layout.mjs",
    "layout:check": "node scripts/layout.mjs --check",
    "build": "vite build",
    "build:ssr": "vite build --ssr src/entry-server.tsx --outDir dist-ssr --emptyOutDir",
    "ssg": "node scripts/ssg.mjs",
    "sitemap": "node scripts/build-sitemap.mjs",
    "verify:data": "node scripts/verify-data.mjs",
    "verify:assets": "node scripts/verify-assets.mjs",
    "verify:dist": "node scripts/verify-dist.mjs",
    "verify:fonts": "python scripts/check-font-coverage.py",
    "notices": "node scripts/build-notices.mjs",
    "notices:check": "node scripts/build-notices.mjs --check",
    "audit:style": "python scripts/vendor/apple-marketing-design/scripts/audit_apple_style.py src public",
    "preview:dist": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "ci:verify": "npm run content && npm run verify:data && npm run verify:assets && npm run layout:check && npm run typecheck && npm run typecheck:files && npm run lint && npm run test:unit && npm run verify:fonts && npm run audit:style && npm run notices:check",
    "ci:build": "npm run build && npm run build:ssr && npm run ssg && npm run sitemap && npm run verify:dist",
    "ci:all": "npm run ci:verify && npm run ci:build && npm run test:e2e"
  },
  "dependencies": {
    "fuse.js": "7.5.0",
    "leaflet": "1.9.4",
    "lucide-react": "1.66.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "react-router": "7.18.5",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/leaflet": "1.9.22",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.14.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
